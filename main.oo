// # ootail Entry Point
//
// Logline: Capability-bounded file tail and follower utility with inotify, windowing, and MCP.
//
// Setup: Demands &FsReadCap for content, &SysCap for inotify, &TimeCap for polling cadence.
//
// Beats:
//   1. Parse options for line/byte windowing, follow mode, MCP server, and output formatting.
//   2. Window file lines or bytes from standard input, MCP stdio, or positional file operands.
//   3. Follow file appends with inotify probe, truncated file recovery, and PID tracking.

import "render/anchor.oo";
import "scan/anchor.oo";
import "watch/anchor.oo";
import "ipc/mcp_serve.oo";
import "tail_opts.oo";
import "std/fs/time/chrono.oo";

fn render_help() -> String {
    return "ootail 0.2.0 (openOODA sovereign tail)\n"
        + "usage: ootail [options] [FILE]...\n"
        + "\n"
        + "Print the last 10 lines of each FILE to standard output.\n"
        + "With more than one FILE, precede each with a header giving the file name.\n"
        + "With no FILE, or when FILE is -, read standard input.\n"
        + "\n"
        + "Options:\n"
        + "  -n, --lines=[+]NUM       output the last NUM lines, or from line NUM with +\n"
        + "  -c, --bytes=[+]NUM       output the last NUM bytes, or from byte NUM with +\n"
        + "  -f, --follow             output appended data as the file grows\n"
        + "  -F                       same as --follow --retry\n"
        + "  -s, --sleep-interval=S   with -f, sleep for S seconds (default: 0.1)\n"
        + "      --pid=PID            with -f, terminate after process PID dies\n"
        + "      --mcp                run Model Context Protocol server over stdio\n"
        + "  -q, --quiet              never output headers giving file names\n"
        + "  -v, --verbose            always output headers giving file names\n"
        + "      --color              colorize log output levels with active theme\n"
        + "      --no-color           disable color formatting\n"
        + "  -h, --help               display this help and exit\n"
        + "  -V, --version            output version information and exit\n";
}

fn print_lines(lines: List[String], theme: String, color_on: Bool, has_trailing_nl: Bool) {
    let n: Int = list_len(lines);
    let mut i: Int = 0;
    while i < n {
        let l: String = list_get(lines, i);
        let rendered: String = render_log_line(l, theme, color_on);
        if i + 1 == n && !has_trailing_nl {
            print(rendered);
        } else {
            print(rendered + "\n");
        }
        i = i + 1;
    }
}

fn drain_stdin(fs: &FsReadCap) -> String {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fs, 100);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if byte_len(chunk) > 0 {
                buf = buf + chunk;
            }
        }
    }
    return buf;
}

fn tail_stdin(fs: &FsReadCap, opt: TailOptions, theme: String, color_on: Bool) -> Int {
    let content: String = drain_stdin(fs);
    if opt.use_bytes {
        let win_bytes: String = if opt.bytes_from_start {
            scan_window_bytes_from(content, opt.bytes)
        } else {
            scan_window_bytes(content, opt.bytes)
        };
        print(win_bytes);
        return 0;
    }
    let n_bytes: Int = byte_len(content);
    let has_trailing_nl: Bool = n_bytes > 0 && byte_get(content, n_bytes - 1) == 10;
    let all_lines: List[String] = scan_split_lines(content);
    let win_lines: List[String] = if opt.lines_from_start {
        scan_window_from(all_lines, opt.lines)
    } else {
        scan_window_tail(all_lines, opt.lines)
    };
    print_lines(win_lines, theme, color_on, has_trailing_nl);
    return 0;
}

fn tail_emit_file(fs: &FsReadCap, path: String, opt: TailOptions, theme: String, color_on: Bool, show_hdr: Bool, is_first: Bool) -> Int {
    if !path_exists(fs, path) {
        print("ootail: cannot open '" + path + "' for reading: No such file or directory\n");
        return 1;
    }
    let r: Result[String, String] = read_file(fs, path);
    if !r.is_ok() {
        print("ootail: error reading '" + path + "'\n");
        return 1;
    }
    let content: String = match r { Ok(s) => s, Err(_) => "" };
    if show_hdr {
        print(render_file_header(path, is_first));
    }
    if opt.use_bytes {
        let win_bytes: String = if opt.bytes_from_start {
            scan_window_bytes_from(content, opt.bytes)
        } else {
            scan_window_bytes(content, opt.bytes)
        };
        print(win_bytes);
        return 0;
    }
    let n_bytes: Int = byte_len(content);
    let has_trailing_nl: Bool = n_bytes > 0 && byte_get(content, n_bytes - 1) == 10;
    let all_lines: List[String] = scan_split_lines(content);
    let win_lines: List[String] = if opt.lines_from_start {
        scan_window_from(all_lines, opt.lines)
    } else {
        scan_window_tail(all_lines, opt.lines)
    };
    print_lines(win_lines, theme, color_on, has_trailing_nl);
    return 0;
}

fn tail_follow_loop(fs: &FsReadCap, sys: &SysCap, time: &TimeCap, env: &EnvCap, opt: TailOptions, theme: String, color_on: Bool, show_hdr: Bool) -> Int {
    let _inotify_ok: Bool = watch_probe_inotify(sys);
    let n_files: Int = list_len(opt.files);
    let mut watchers: List[TailWatch] = list_new();
    let mut i: Int = 0;
    while i < n_files {
        watchers = list_push(watchers, watch_file_init(fs, list_get(opt.files, i)));
        i = i + 1;
    }
    let cycle_env: Result[String, String] = env_get(env, "OODA_TAIL_CYCLES");
    let max_cycles: Int = match cycle_env { Ok(s) => parse_tail_int(s), Err(_) => 0 - 1 };
    let sleep_ms: Int = opt.sleep_interval_ms;
    let mut cycle: Int = 0;
    while max_cycles < 0 || cycle < max_cycles {
        if opt.pid > 0 {
            let pid_path: String = "/proc/" + opt.pid.to_string();
            if !path_exists(fs, pid_path) {
                break;
            }
        }
        let mut j: Int = 0;
        let mut next_watchers: List[TailWatch] = list_new();
        while j < n_files {
            let w0: TailWatch = list_get(watchers, j);
            let w: TailWatch = watch_file_check(fs, w0);
            if w.is_truncated { print(render_truncated_notice(w.path)); }
            if watch_has_new_data(w) {
                let rd: WatchReadResult = watch_read_append(fs, w);
                if rd.ok && byte_len(rd.bytes) > 0 {
                    if show_hdr { print(render_file_header(w.path, false)); }
                    let n_b: Int = byte_len(rd.bytes);
                    let trail_nl: Bool = byte_get(rd.bytes, n_b - 1) == 10;
                    let new_lines: List[String] = scan_split_lines(rd.bytes);
                    print_lines(new_lines, theme, color_on, trail_nl);
                }
                next_watchers = list_push(next_watchers, rd.new_watch);
            } else {
                next_watchers = list_push(next_watchers, w);
            }
            j = j + 1;
        }
        watchers = next_watchers;
        chrono_sleep_ms(time, sleep_ms);
        cycle = cycle + 1;
    }
    return 0;
}

pub fn main(fs: &FsReadCap, sys: &SysCap, time: &TimeCap, proc_cap: &ProcessCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let opt: TailOptions = parse_tail_args(args);
    if opt.show_help { print(render_help()); return Ok(0); }
    if opt.show_version { print("ootail 0.2.0 (openOODA sovereign tail)\n"); return Ok(0); }
    if opt.error_msg != "" {
        print("ootail: " + opt.error_msg + "\nTry 'ootail --help' for more information.\n");
        process_exit(2);
        return Ok(2);
    }
    if opt.mcp_mode {
        let mcp_rc: Int = run_mcp_server(fs);
        return Ok(mcp_rc);
    }
    let theme: String = resolve_tail_theme(fs, env);
    let color_on: Bool = opt.color;
    let num_files: Int = list_len(opt.files);
    let mut rc: Int = 0;
    if num_files == 0 || (num_files == 1 && list_get(opt.files, 0) == "-") {
        rc = tail_stdin(fs, opt, theme, color_on);
        if rc != 0 { process_exit(rc); }
        return Ok(rc);
    }
    let show_hdr: Bool = (num_files > 1 || opt.verbose) && !opt.quiet;
    let mut i: Int = 0;
    while i < num_files {
        let f: String = list_get(opt.files, i);
        let cur_rc: Int = tail_emit_file(fs, f, opt, theme, color_on, show_hdr, i == 0);
        if cur_rc != 0 { rc = cur_rc; }
        i = i + 1;
    }
    if opt.follow {
        tail_follow_loop(fs, sys, time, env, opt, theme, color_on, show_hdr);
    }
    if rc != 0 { process_exit(rc); }
    return Ok(rc);
}
