// # Tail Options - Command Line Argument Parsing
//
// Logline: Parses command line flags into typed TailOptions configuration.
//
// Setup: Pure string argument parser with GNU tail flag compatibility.
//
// Beats:
//   1. Parse line count flags (-n, --lines, or leading digit shortcut).
//   2. Parse follow flags (-f, -F), quiet, verbose, and color toggles.
//   3. Separate positional file operands from option flags.

import "std/core/primitives/byte.oo";

pub type TailOptions = struct {
    lines: Int,
    follow: Bool,
    follow_retry: Bool,
    quiet: Bool,
    verbose: Bool,
    color: Bool,
    files: List[String],
    show_help: Bool,
    show_version: Bool,
    error_msg: String
};

pub fn parse_tail_int(s: String) -> Int {
    let n: Int = byte_len(s);
    if n == 0 { return 10; }
    let mut acc: Int = 0;
    let mut i: Int = 0;
    if byte_get(s, 0) == 43 { i = 1; }
    while i < n {
        let b: Int = byte_get(s, i);
        if b >= 48 && b <= 57 {
            acc = acc * 10 + (b - 48);
        } else {
            return acc;
        }
        i = i + 1;
    }
    return acc;
}

fn is_numeric_flag(s: String) -> Bool {
    let n: Int = byte_len(s);
    if n < 2 { return false; }
    if byte_get(s, 0) != 45 { return false; }
    let b1: Int = byte_get(s, 1);
    return b1 >= 48 && b1 <= 57;
}

pub fn tail_options_default() -> TailOptions {
    return TailOptions {
        lines: 10,
        follow: false,
        follow_retry: false,
        quiet: false,
        verbose: false,
        color: false,
        files: list_new(),
        show_help: false,
        show_version: false,
        error_msg: ""
    };
}

pub fn parse_tail_args(args: List[String]) -> TailOptions {
    let mut opt: TailOptions = tail_options_default();
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" { opt.show_help = true; return opt; }
        if arg == "-V" || arg == "-v" && !opt.verbose || arg == "--version" {
            if arg == "-V" || arg == "--version" { opt.show_version = true; return opt; }
        }
        if arg == "-f" || arg == "--follow" { opt.follow = true; i = i + 1; }
        else if arg == "-F" { opt.follow = true; opt.follow_retry = true; i = i + 1; }
        else if arg == "-q" || arg == "--quiet" || arg == "--silent" { opt.quiet = true; i = i + 1; }
        else if arg == "-v" || arg == "--verbose" { opt.verbose = true; i = i + 1; }
        else if arg == "--color" { opt.color = true; i = i + 1; }
        else if arg == "--no-color" { opt.color = false; i = i + 1; }
        else if arg == "-n" || arg == "--lines" {
            if i + 1 < n { opt.lines = parse_tail_int(list_get(args, i + 1)); i = i + 2; }
            else { opt.error_msg = "option requires an argument -- 'n'"; return opt; }
        } else if is_numeric_flag(arg) {
            opt.lines = parse_tail_int(byte_sub(arg, 1, byte_len(arg))); i = i + 1;
        } else if str_starts_with(arg, "--lines=") {
            opt.lines = parse_tail_int(str_slice(arg, 8, chars_len(arg))); i = i + 1;
        } else if str_starts_with(arg, "-") && arg != "-" {
            opt.error_msg = "invalid option -- '" + arg + "'"; return opt;
        } else {
            opt.files = list_push(opt.files, arg); i = i + 1;
        }
    }
    return opt;
}
