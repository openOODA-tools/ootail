// # Tail Options - Command Line Argument Parsing
//
// Logline: Parses command line flags into typed TailOptions configuration.
//
// Setup: Pure string argument parser with GNU tail flag compatibility.
//
// Beats:
//   1. Parse line and byte windowing flags (-n, -c, +NUM, -NUM).
//   2. Parse follow flags (-f, -F), sleep interval, PID, and quiet/verbose toggles.
//   3. Separate positional file operands from option flags.

import "std/core/primitives/byte.oo";

pub type TailOptions = struct {
    lines: Int,
    lines_from_start: Bool,
    bytes: Int,
    bytes_from_start: Bool,
    use_bytes: Bool,
    follow: Bool,
    follow_retry: Bool,
    sleep_interval_ms: Int,
    pid: Int,
    quiet: Bool,
    verbose: Bool,
    color: Bool,
    mcp_mode: Bool,
    files: List[String],
    show_help: Bool,
    show_version: Bool,
    error_msg: String
};

pub fn parse_tail_int(s: String) -> Int {
    let n: Int = byte_len(s);
    if n == 0 { return 10; }
    let mut acc: Int = 0;
    let mut i: Int = 0;
    if byte_get(s, 0) == 43 || byte_get(s, 0) == 45 { i = 1; }
    while i < n {
        let b: Int = byte_get(s, i);
        if b >= 48 && b <= 57 {
            acc = acc * 10 + (b - 48);
        } else {
            return acc;
        }
        i = i + 1;
    }
    return acc;
}

pub fn parse_tail_interval_ms(s: String) -> Int {
    let n: Int = byte_len(s);
    if n == 0 { return 100; }
    let dot: Int = str_index_of(s, ".");
    if dot < 0 {
        let sec: Int = parse_tail_int(s);
        return if sec > 0 { sec * 1000 } else { 100 };
    }
    let sec_part: String = str_slice(s, 0, dot);
    let frac_part: String = str_slice(s, dot + 1, chars_len(s));
    let sec: Int = if chars_len(sec_part) == 0 { 0 } else { parse_tail_int(sec_part) };
    let frac_len: Int = byte_len(frac_part);
    let mut ms: Int = 0;
    if frac_len > 0 {
        let d1: Int = byte_get(frac_part, 0) - 48;
        if d1 >= 0 && d1 <= 9 { ms = ms + d1 * 100; }
    }
    if frac_len > 1 {
        let d2: Int = byte_get(frac_part, 1) - 48;
        if d2 >= 0 && d2 <= 9 { ms = ms + d2 * 10; }
    }
    if frac_len > 2 {
        let d3: Int = byte_get(frac_part, 2) - 48;
        if d3 >= 0 && d3 <= 9 { ms = ms + d3; }
    }
    let total: Int = sec * 1000 + ms;
    return if total > 0 { total } else { 100 };
}

fn has_plus_prefix(s: String) -> Bool {
    let n: Int = byte_len(s);
    return n > 0 && byte_get(s, 0) == 43;
}

fn is_numeric_flag(s: String) -> Bool {
    let n: Int = byte_len(s);
    if n < 2 { return false; }
    let b0: Int = byte_get(s, 0);
    if b0 != 45 && b0 != 43 { return false; }
    let b1: Int = byte_get(s, 1);
    return b1 >= 48 && b1 <= 57;
}

pub fn tail_options_default() -> TailOptions {
    return TailOptions {
        lines: 10,
        lines_from_start: false,
        bytes: 0,
        bytes_from_start: false,
        use_bytes: false,
        follow: false,
        follow_retry: false,
        sleep_interval_ms: 100,
        pid: 0,
        quiet: false,
        verbose: false,
        color: false,
        mcp_mode: false,
        files: list_new(),
        show_help: false,
        show_version: false,
        error_msg: ""
    };
}

pub fn parse_tail_args(args: List[String]) -> TailOptions {
    let mut opt: TailOptions = tail_options_default();
    let n: Int = list_len(args);
    let mut i: Int = 0;
    let mut end_of_opts: Bool = false;
    while i < n {
        let arg: String = list_get(args, i);
        if end_of_opts {
            opt.files = list_push(opt.files, arg);
            i = i + 1;
        } else if arg == "--" {
            end_of_opts = true;
            i = i + 1;
        } else if arg == "-h" || arg == "--help" {
            opt.show_help = true; return opt;
        } else if arg == "-V" || arg == "--version" {
            opt.show_version = true; return opt;
        } else if arg == "--mcp" {
            opt.mcp_mode = true; i = i + 1;
        } else if arg == "-f" || arg == "--follow" {
            opt.follow = true; i = i + 1;
        } else if arg == "-F" {
            opt.follow = true; opt.follow_retry = true; i = i + 1;
        } else if arg == "-q" || arg == "--quiet" || arg == "--silent" {
            opt.quiet = true; i = i + 1;
        } else if arg == "-v" || arg == "--verbose" {
            opt.verbose = true; i = i + 1;
        } else if arg == "--color" {
            opt.color = true; i = i + 1;
        } else if arg == "--no-color" {
            opt.color = false; i = i + 1;
        } else if arg == "-n" || arg == "--lines" {
            if i + 1 < n {
                let val: String = list_get(args, i + 1);
                opt.lines_from_start = has_plus_prefix(val);
                opt.lines = parse_tail_int(val);
                i = i + 2;
            } else {
                opt.error_msg = "option requires an argument -- 'n'"; return opt;
            }
        } else if str_starts_with(arg, "--lines=") {
            let val: String = str_slice(arg, 8, chars_len(arg));
            opt.lines_from_start = has_plus_prefix(val);
            opt.lines = parse_tail_int(val);
            i = i + 1;
        } else if arg == "-c" || arg == "--bytes" {
            if i + 1 < n {
                let val: String = list_get(args, i + 1);
                opt.use_bytes = true;
                opt.bytes_from_start = has_plus_prefix(val);
                opt.bytes = parse_tail_int(val);
                i = i + 2;
            } else {
                opt.error_msg = "option requires an argument -- 'c'"; return opt;
            }
        } else if str_starts_with(arg, "--bytes=") {
            let val: String = str_slice(arg, 8, chars_len(arg));
            opt.use_bytes = true;
            opt.bytes_from_start = has_plus_prefix(val);
            opt.bytes = parse_tail_int(val);
            i = i + 1;
        } else if arg == "-s" || arg == "--sleep-interval" {
            if i + 1 < n {
                opt.sleep_interval_ms = parse_tail_interval_ms(list_get(args, i + 1));
                i = i + 2;
            } else {
                opt.error_msg = "option requires an argument -- 's'"; return opt;
            }
        } else if str_starts_with(arg, "--sleep-interval=") {
            opt.sleep_interval_ms = parse_tail_interval_ms(str_slice(arg, 17, chars_len(arg)));
            i = i + 1;
        } else if str_starts_with(arg, "--pid=") {
            opt.pid = parse_tail_int(str_slice(arg, 6, chars_len(arg)));
            i = i + 1;
        } else if is_numeric_flag(arg) {
            opt.lines_from_start = has_plus_prefix(arg);
            opt.lines = parse_tail_int(arg);
            i = i + 1;
        } else if str_starts_with(arg, "-") && arg != "-" {
            opt.error_msg = "invalid option -- '" + arg + "'"; return opt;
        } else {
            opt.files = list_push(opt.files, arg); i = i + 1;
        }
    }
    return opt;
}
