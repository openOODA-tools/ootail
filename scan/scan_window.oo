// # Scan Window - File Line and Byte Windowing
//
// Logline: Splits text into line lists and applies count windowing for lines and bytes.
//
// Setup: Pure list and byte manipulation over text payloads.
//
// Beats:
//   1. Split raw text buffer into list of lines by newline byte offset.
//   2. Slice last N lines or start from line K (line windowing).
//   3. Slice last N bytes or start from byte K (byte windowing).

import "std/core/primitives/byte.oo";
import "scan_take_line.oo";

pub fn scan_split_lines(content: String) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = byte_len(content);
    if n == 0 { return out; }
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if byte_get(content, i) == 10 {
            let raw: String = byte_sub(content, start, i);
            out = list_push(out, scan_strip_cr(raw));
            start = i + 1;
        }
        i = i + 1;
    }
    if start < n {
        let tail_part: String = byte_sub(content, start, n);
        out = list_push(out, scan_strip_cr(tail_part));
    }
    return out;
}

pub fn scan_window_tail(lines: List[String], count: Int) -> List[String] {
    let total: Int = list_len(lines);
    if count <= 0 { return list_new(); }
    if total <= count { return lines; }
    let start_idx: Int = total - count;
    let mut res: List[String] = list_new();
    let mut i: Int = start_idx;
    while i < total {
        res = list_push(res, list_get(lines, i));
        i = i + 1;
    }
    return res;
}

pub fn scan_window_from(lines: List[String], start_line: Int) -> List[String] {
    let total: Int = list_len(lines);
    let mut idx: Int = start_line - 1;
    if idx < 0 { idx = 0; }
    let mut res: List[String] = list_new();
    while idx < total {
        res = list_push(res, list_get(lines, idx));
        idx = idx + 1;
    }
    return res;
}

pub fn scan_window_bytes(content: String, count: Int) -> String {
    let n: Int = byte_len(content);
    if count <= 0 { return ""; }
    if n <= count { return content; }
    return byte_sub(content, n - count, n);
}

pub fn scan_window_bytes_from(content: String, start_byte: Int) -> String {
    let n: Int = byte_len(content);
    let mut idx: Int = start_byte - 1;
    if idx < 0 { idx = 0; }
    if idx >= n { return ""; }
    return byte_sub(content, idx, n);
}
