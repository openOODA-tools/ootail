// # ootail Project Anchor
//
// Logline: Names the four ootail domains and the one job each one owns.
//
// Setup: Skeleton. Imports nothing and re-exports nothing; it exists to be the map.
//
// Beats:
//   1. Bind watch, scan, render, and ipc to a single responsibility each.
//   2. Leave the domain list readable so a missing domain is obvious.

pub fn ootail_domains() -> List[String] {
    let d: List[String] = list_new();
    let d2: List[String] = list_push(d, "watch: file and directory change events");
    let d3: List[String] = list_push(d2, "scan: bytes arriving into whole lines");
    let d4: List[String] = list_push(d3, "render: emitted lines to output");
    return list_push(d4, "ipc: CLI, MCP stdio, and AF_UNIX socket");
}
