// # Tail Log Theme - Configuration Resolver
//
// Logline: Hydrates log level color tokens from ~/.openooda/theme.oot and environment variables.
//
// Setup: Pure string parser and token mapper. Operates with zero ambient authority.
//
// Beats:
//   1. Parse key-value bindings from theme.oot configuration text.
//   2. Extract theme name and lighting mode from configuration text.
//   3. Map log tokens (log_trace, log_debug, log_info, log_warn, log_error) to ANSI codes.
//   4. Resolve default configuration path under openOODA home directory.

import "std/fs/process/env.oo";

pub fn parse_theme_key(content: String, key: String) -> String {
    let n: Int = chars_len(content);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(content, i);
        if c == "\n" {
            let trimmed: String = str_trim(cur);
            if str_starts_with(trimmed, key) {
                let rest: String = str_trim(str_slice(trimmed, chars_len(key), chars_len(trimmed)));
                if str_starts_with(rest, "=") {
                    let mut val: String = str_trim(str_slice(rest, 1, chars_len(rest)));
                    if str_starts_with(val, "\"") && str_ends_with(val, "\"") {
                        let vn: Int = chars_len(val);
                        if vn >= 2 { val = str_slice(val, 1, vn - 1); }
                    }
                    if val != "" { return val; }
                }
            }
            cur = "";
        } else if c != "\r" {
            cur = cur + c;
        }
        i = i + 1;
    }
    return "";
}

pub fn theme_log_trace(theme: String) -> String {
    return "90";
}

pub fn theme_log_debug(theme: String) -> String {
    if theme == "1982" || theme == "cyberpunk" { return "36"; }
    return "37";
}

pub fn theme_log_info(theme: String) -> String {
    if theme == "1982" || theme == "cyberpunk" { return "32"; }
    return "34";
}

pub fn theme_log_warn(theme: String) -> String {
    return "33";
}

pub fn theme_log_error(theme: String) -> String {
    return "31";
}

pub fn theme_config_path(home: String) -> String {
    if chars_len(home) == 0 { return "theme.oot"; }
    if str_ends_with(home, "/") { return home + ".openooda/theme.oot"; }
    return home + "/.openooda/theme.oot";
}

pub fn resolve_tail_theme(fs: &FsReadCap, env: &EnvCap) -> String {
    let env_t: Result[String, String] = env_get(env, "OODA_THEME");
    if env_t.is_ok() {
        let t: String = match env_t { Ok(s) => s, Err(_) => "" };
        if t != "" { return t; }
    }
    let env_home: Result[String, String] = env_get(env, "OODA_HOME");
    let mut home: String = match env_home { Ok(s) => s, Err(_) => "" };
    if home == "" {
        let env_w: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
        home = match env_w { Ok(s) => s, Err(_) => "" };
    }
    if home == "" {
        let env_h: Result[String, String] = env_get(env, "HOME");
        home = match env_h { Ok(s) => s, Err(_) => "" };
    }
    let p: String = theme_config_path(home);
    let r: Result[String, String] = read_file(fs, p);
    if r.is_err() { return "auto"; }
    let content: String = match r { Ok(s) => s, Err(_) => "" };
    let t: String = parse_theme_key(content, "theme");
    return if t != "" { t } else { "auto"; };
}
